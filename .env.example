# Copie para .env e ajuste. Sem .env, a aplicação usa SQLite (clacs.db) e as credenciais de desenvolvimento abaixo.

# ---------------------------------------------------------------- base de dados e segurança
DATABASE_URL=sqlite:///./clacs.db
# DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/clacs

# Segredo dos tokens de sessão. Com PostgreSQL é OBRIGATÓRIO mudar (32+ caracteres) ou a API não arranca.
JWT_SECRET=dev-secret-local-mudar-em-producao-0000

# Administrador criado pelo seed (só no primeiro arranque). Credenciais de desenvolvimento local.
# Os dados de demonstração criam também professor@clacs.ao e encarregado@clacs.ao com esta senha.
ADMIN_EMAIL=admin@clacs.ao
ADMIN_PASSWORD=admin123
SEED_DEMO=false

CORS_ORIGINS=*
# Endereço do frontend, usado no link do e-mail de recuperação de senha.
FRONTEND_URL=http://localhost:5173

# Bloqueio de login: 5 falhas por e-mail (20 por IP) bloqueiam durante 15 minutos.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# ---------------------------------------------------------------- agendador interno
# true = tarefas diárias (cobranças, multas, regras, alertas), envio da fila a cada 10 min e relatórios agendados.
# Ligue só numa instância da API.
AGENDADOR_ACTIVO=false
AGENDADOR_HORA=06:00
FUSO_HORARIO=Africa/Luanda

# ---------------------------------------------------------------- ficheiros
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# ---------------------------------------------------------------- e-mail (vazio = só regista no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CLACS Escola <no-reply@clacs.ao>
SMTP_TLS=true

# ---------------------------------------------------------------- WhatsApp (vazio = simulado)
# zapi = Z-API (não oficial, liga um telemóvel); meta = Cloud API oficial da Meta.
WHATSAPP_PROVEDOR=zapi
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Cloud API da Meta (só com WHATSAPP_PROVEDOR=meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSAO=v21.0
# Modelo aprovado pela Meta com uma variável {{1}}; necessário para escrever a quem não falou com a escola nas últimas 24 h.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LINGUA=pt_PT

# ---------------------------------------------------------------- SMS via Twilio (vazio = simulado)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------- pagamentos por referência
# "simulado" até haver contrato com um gateway. O webhook exige o segredo (HMAC-SHA256 no cabeçalho X-Assinatura).
PAGAMENTOS_GATEWAY=simulado
PAGAMENTOS_WEBHOOK_SEGREDO=
PAGAMENTOS_ENTIDADE=00000

# ---------------------------------------------------------------- Primavera (ver app/integracoes/primavera.py)
# Em integracao_config.credenciais_ref ponha "PRIMAVERA"; as credenciais ficam aqui, nunca na base de dados.
PRIMAVERA_USER=
PRIMAVERA_PASSWORD=
PRIMAVERA_COMPANY=
PRIMAVERA_INSTANCE=DEFAULT
PRIMAVERA_LINE=Professional

# ---------------------------------------------------------------- assistente com IA (vazio = respostas por regras)
ANTHROPIC_API_KEY=
ASSISTENTE_MODELO=claude-opus-5-5

# ---------------------------------------------------------------- notificações push (vazio = só regista)
# Caminho do ficheiro JSON da conta de serviço do Firebase (Definições do projecto > Contas de serviço).
FCM_CREDENCIAIS=
